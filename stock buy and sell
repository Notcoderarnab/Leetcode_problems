class Solution {
    public int maxProfit(int[] prices) {
        // Start min_price at the highest possible integer so the first day becomes the min
        int min_price = Integer.MAX_VALUE; 
        int max_profit = 0;
        
        for (int i = 0; i < prices.length; i++) {
            // If today is cheaper than the lowest price we've seen, update our lowest price
            if (prices[i] < min_price) {
                min_price = prices[i];
            } 
            // Otherwise, check if selling today gives us a new maximum profit
            else if (prices[i] - min_price > max_profit) {
                max_profit = prices[i] - min_price;
            }
        }
        
        return max_profit;
    }
}
